# App
APP_NAME=flowlab
APP_ENV=local          # local | staging | production

# python main.py server:start (overridable with --host / --port / --reload)
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8000

# CORS (comma-separated; origins default to * on local and to none elsewhere)
# CORS_ORIGINS=https://app.example.com
# CORS_ORIGIN_REGEX=
# CORS_METHODS=*
# CORS_HEADERS=*
# CORS_CREDENTIALS=false

# MCP (served at MCP_PATH, authenticated with API keys: python main.py api-keys:create)
# MCP_NAME=flowlab
# MCP_PATH=/mcp

# Auth (JWT_SECRET is required by the auth module; the users table lives in migrations/)
JWT_SECRET=change-me
JWT_TTL_MINUTES=60
# Login and register attempts per client, like 10/5 minutes; none turns it off
AUTH_RATE_LIMIT=5/minute

# Database: sqlite | postgresql | mysql | mariadb
# A relative sqlite DB_NAME resolves against the directory of main.py.
DB_DRIVER=sqlite
DB_NAME=database.sqlite
# DB_HOST=localhost
# DB_PORT=
# DB_USER=
# DB_PASSWORD=

# Cache: memory | database | redis | valkey | memcached
# database creates its table (CACHE_TABLE, default cache) at startup if it does not exist.
# redis / valkey / memcached need the matching flowlab extra, e.g. flowlab[redis].
CACHE_DRIVER=memory
# CACHE_HOST=localhost
# CACHE_PORT=
# CACHE_PASSWORD=

# Queue: sync | database | redis | valkey
# sync runs jobs as they are dispatched; the others need a worker: python main.py queue:work
# database uses the jobs and failed_jobs tables from migrations/ (python main.py queue:install).
QUEUE_DRIVER=database
# QUEUE_NAME=default
# QUEUE_RETRY_AFTER=90
# QUEUE_HOST=localhost
# QUEUE_PORT=6379
# QUEUE_PASSWORD=
